+package com.acmehealth.priorauth.api;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.TestConfiguration;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Primary;
+import org.springframework.test.web.servlet.MockMvc;
+
+import java.time.Clock;
+import java.time.Instant;
+import java.time.ZoneId;
+
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+/** Meena's decision on 3.6: a row received tomorrow (clock skew, time zones) must not fail the call. */
+@SpringBootTest
+@AutoConfigureMockMvc
+class PendingRequestsReceivedTomorrowTest {
+
+    /** "Today" is Thu 8 Oct 2026, so the sample's PA-10263 (received Fri 9 Oct) arrived tomorrow. */
+    @TestConfiguration
+    static class FixedClock {
+        @Bean
+        @Primary
+        Clock fixedClock() {
+            return Clock.fixed(Instant.parse("2026-10-08T17:00:00Z"), ZoneId.of("America/Chicago"));
+        }
+    }
+
+    @Autowired
+    private MockMvc mvc;
+
+    @Test
+    void rowReceivedTomorrowIsAgeZeroWithoutAsOf() throws Exception {
+        mvc.perform(get("/requests/pending"))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.length()").value(3))
+                .andExpect(jsonPath("$[2].id").value("PA-10263"))
+                .andExpect(jsonPath("$[2].receivedAt").value("2026-10-09"))
+                .andExpect(jsonPath("$[2].ageBusinessDays").value(0))
+                .andExpect(jsonPath("$[2].overLimit").value(false))
+                .andExpect(jsonPath("$[2].ageLabel").value("0 bd"));
+    }
+}
