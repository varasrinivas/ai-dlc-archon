+package com.acmehealth.priorauth.api;
+
+import org.junit.jupiter.api.Test;
+import tools.jackson.databind.json.JsonMapper;
+
+import java.time.LocalDate;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/** The business-day rule (R1, R2, R14), against the real TX-01 holiday file. */
+class BusinessDayCalendarTest {
+
+    private final BusinessDayCalendar calendar = new BusinessDayCalendar(JsonMapper.builder().build());
+
+    private int age(String tenant, String received, String asOf) {
+        return calendar.businessDaysAfter(tenant, LocalDate.parse(received), LocalDate.parse(asOf));
+    }
+
+    @Test
+    void receivedOnTheAsOfDateIsDayZero() {
+        assertThat(age("TX-01", "2026-10-13", "2026-10-13")).isZero();
+    }
+
+    @Test
+    void weekendsDoNotCount() {
+        // Fri 16 Oct -> Mon 19 Oct
+        assertThat(age("TX-01", "2026-10-16", "2026-10-19")).isEqualTo(1);
+    }
+
+    @Test
+    void holidaysDoNotCount() {
+        // Fri 9 Oct -> Tue 13 Oct; Mon 12 Oct is a holiday
+        assertThat(age("TX-01", "2026-10-09", "2026-10-13")).isEqualTo(1);
+        // Wed 25 Nov -> Mon 30 Nov; Thu 26 and Fri 27 Nov are holidays
+        assertThat(age("TX-01", "2026-11-25", "2026-11-30")).isEqualTo(1);
+    }
+
+    @Test
+    void receivedOnASaturdayCountsFromTheNextBusinessDay() {
+        // Sat 17 Oct -> Mon 19 Oct
+        assertThat(age("TX-01", "2026-10-17", "2026-10-19")).isEqualTo(1);
+    }
+
+    @Test
+    void receivedOnAHolidayCountsFromTheNextBusinessDay() {
+        // Mon 12 Oct (holiday) -> Tue 13 Oct
+        assertThat(age("TX-01", "2026-10-12", "2026-10-13")).isEqualTo(1);
+    }
+
+    @Test
+    void tenantWithoutAHolidayFileSkipsWeekendsOnly() {
+        // Fri 9 Oct -> Tue 13 Oct; no holidays known, so Mon 12 Oct counts
+        assertThat(age("ZZ-99", "2026-10-09", "2026-10-13")).isEqualTo(2);
+    }
+}
