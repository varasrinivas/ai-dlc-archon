+package com.acmehealth.priorauth.api;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.core.io.ClassPathResource;
+import org.springframework.stereotype.Component;
+import tools.jackson.databind.json.JsonMapper;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.UncheckedIOException;
+import java.time.DayOfWeek;
+import java.time.LocalDate;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Business days per tenant: Monday to Friday, minus the tenant's holidays from
+ * {@code data/holidays-<tenantId>-2026.json}. Same rule as the nightly report (intent 261013-request-age-api).
+ */
+@Component
+public class BusinessDayCalendar {
+
+    private static final Logger log = LoggerFactory.getLogger(BusinessDayCalendar.class);
+
+    private final JsonMapper mapper;
+    private final Map<String, Set<LocalDate>> holidaysByTenant = new ConcurrentHashMap<>();
+
+    public BusinessDayCalendar(JsonMapper mapper) {
+        this.mapper = mapper;
+    }
+
+    /** Business days after {@code from} up to and including {@code to}; {@code from} itself is day 0. */
+    public int businessDaysAfter(String tenantId, LocalDate from, LocalDate to) {
+        Set<LocalDate> holidays = holidays(tenantId);
+        int days = 0;
+        for (LocalDate d = from.plusDays(1); !d.isAfter(to); d = d.plusDays(1)) {
+            if (d.getDayOfWeek() != DayOfWeek.SATURDAY && d.getDayOfWeek() != DayOfWeek.SUNDAY
+                    && !holidays.contains(d)) {
+                days++;
+            }
+        }
+        return days;
+    }
+
+    private Set<LocalDate> holidays(String tenantId) {
+        return holidaysByTenant.computeIfAbsent(tenantId, this::load);
+    }
+
+    private Set<LocalDate> load(String tenantId) {
+        ClassPathResource file = new ClassPathResource("data/holidays-" + tenantId + "-2026.json");
+        if (!file.exists()) {
+            log.warn("No holiday file {} for tenant {}: counting weekends only", file.getPath(), tenantId);
+            return Set.of();
+        }
+        try (InputStream in = file.getInputStream()) {
+            List<LocalDate> dates = mapper.readValue(in, mapper.getTypeFactory()
+                    .constructCollectionType(List.class, LocalDate.class));
+            return Set.copyOf(dates);
+        } catch (IOException e) {
+            throw new UncheckedIOException("Cannot read " + file.getPath(), e);
+        }
+    }
+}
