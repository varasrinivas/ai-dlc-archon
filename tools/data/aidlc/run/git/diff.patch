 package com.acmehealth.priorauth.api;
 
+import com.acmehealth.priorauth.model.PriorAuthRequest;
 import com.acmehealth.priorauth.store.RequestStore;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.format.annotation.DateTimeFormat;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ProblemDetail;
+import org.springframework.web.bind.annotation.ExceptionHandler;
 import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RequestParam;
 import org.springframework.web.bind.annotation.RestController;
 
+import java.time.Clock;
+import java.time.LocalDate;
+import java.util.Comparator;
 import java.util.List;
 
-/** GET /requests/pending: the list the reviewer screen shows, oldest first. */
+/** GET /requests/pending: the list the reviewer screen shows, oldest first, with each row's business-day age. */
 @RestController
 public class PendingRequestsController {
 
     private final RequestStore store;
+    private final BusinessDayCalendar calendar;
+    private final Clock clock;
+    private final int thresholdDays;
 
-    public PendingRequestsController(RequestStore store) {
+    public PendingRequestsController(RequestStore store, BusinessDayCalendar calendar, Clock clock,
+                                     @Value("${priorauth.aging.threshold-days}") int thresholdDays) {
         this.store = store;
+        this.calendar = calendar;
+        this.clock = clock;
+        this.thresholdDays = thresholdDays;
     }
 
+    /**
+     * {@code asOf} pins the date ages are counted to; without it (or empty), today in the server's time zone.
+     * It must lie between the newest row's receivedAt and today.
+     */
     @GetMapping("/requests/pending")
-    public List<PendingRequestResponse> pending() {
-        return store.pending().stream().map(PendingRequestResponse::from).toList();
+    public List<PendingRequestResponse> pending(
+            @RequestParam(required = false) @DateTimeFormat(iso = DateTimeFormat.ISO.DATE) LocalDate asOf) {
+        LocalDate today = LocalDate.now(clock);
+        LocalDate date = asOf != null ? asOf : today;
+        if (date.isAfter(today)) {
+            throw new BadAsOfException("asOf is after today; the latest allowed asOf is " + today);
+        }
+        List<PriorAuthRequest> pending = store.pending();
+        pending.stream().map(PriorAuthRequest::receivedAt).max(Comparator.naturalOrder())
+                .filter(date::isBefore)
+                .ifPresent(newest -> {
+                    throw new BadAsOfException(
+                            "asOf is before a request's receivedAt; the earliest allowed asOf is " + newest);
+                });
+        return pending.stream()
+                .map(r -> PendingRequestResponse.from(r,
+                        calendar.businessDaysAfter(r.tenantId(), r.receivedAt(), date), thresholdDays))
+                .toList();
+    }
+
+    @ExceptionHandler(BadAsOfException.class)
+    ProblemDetail badAsOf(BadAsOfException e) {
+        return ProblemDetail.forStatusAndDetail(HttpStatus.BAD_REQUEST, e.getMessage());
+    }
+
+    static class BadAsOfException extends RuntimeException {
+        BadAsOfException(String message) {
+            super(message);
+        }
     }
 }
