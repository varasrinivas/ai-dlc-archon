+package com.acmehealth.priorauth.api;
+
+import com.acmehealth.priorauth.model.PriorAuthRequest;
+import org.junit.jupiter.api.Test;
+
+import java.time.LocalDate;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/** The over-limit flag and label (R3, R4): "over" means more than the threshold. */
+class PendingRequestResponseTest {
+
+    private final PriorAuthRequest request = new PriorAuthRequest("PA-1", "TX-01", "M-1", "CT abdomen", "PENDED",
+            LocalDate.parse("2026-10-01"));
+
+    @Test
+    void ageAtTheThresholdIsNotOver() {
+        PendingRequestResponse row = PendingRequestResponse.from(request, 5, 5);
+        assertThat(row.overLimit()).isFalse();
+        assertThat(row.ageLabel()).isEqualTo("5 bd");
+    }
+
+    @Test
+    void ageAboveTheThresholdIsOver() {
+        PendingRequestResponse row = PendingRequestResponse.from(request, 6, 5);
+        assertThat(row.overLimit()).isTrue();
+        assertThat(row.ageLabel()).isEqualTo("6 bd OVER 5");
+    }
+
+    @Test
+    void labelUsesTheConfiguredThreshold() {
+        assertThat(PendingRequestResponse.from(request, 4, 3).ageLabel()).isEqualTo("4 bd OVER 3");
+    }
+}
