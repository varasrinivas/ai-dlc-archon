Author: Kiran Rao <kiran@acme-health.example>
Date:   Wed Nov 4 17:58:28 2026 +0530

    Pending list: asOf after today is a 400
    
    A future asOf is a caller error under FR11, as Meena decided. It used to be accepted, and asOf=+999999999-12-31 overflowed in the age count and returned 500. An empty asOf still means today; both now have a test.
---
 src/main/java/com/acmehealth/priorauth/api/PendingRequestsController.java  |  7 ++++++-
 .../java/com/acmehealth/priorauth/api/PendingRequestsControllerTest.java   | 18 ++++++++++++++++++
 2 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/src/main/java/com/acmehealth/priorauth/api/PendingRequestsController.java b/src/main/java/com/acmehealth/priorauth/api/PendingRequestsController.java
index d336a54..eb4dfb1 100644
--- a/src/main/java/com/acmehealth/priorauth/api/PendingRequestsController.java
+++ b/src/main/java/com/acmehealth/priorauth/api/PendingRequestsController.java
@@ -32,7 +32,12 @@ public class PendingRequestsController {
     public List<PendingRequestResponse> pending(
             @RequestParam(required = false) @DateTimeFormat(iso = DateTimeFormat.ISO.DATE) LocalDate asOf) {
         List<PriorAuthRequest> rows = store.pending();
+        LocalDate today = LocalDate.now(clock);
         if (asOf != null) {
+            if (asOf.isAfter(today)) {
+                throw new ResponseStatusException(HttpStatus.BAD_REQUEST,
+                        "asOf " + asOf + " is after today " + today);
+            }
             for (PriorAuthRequest r : rows) {
                 if (r.receivedAt().isAfter(asOf)) {
                     throw new ResponseStatusException(HttpStatus.BAD_REQUEST,
@@ -40,7 +45,7 @@ public class PendingRequestsController {
                 }
             }
         }
-        LocalDate day = asOf != null ? asOf : LocalDate.now(clock);
+        LocalDate day = asOf != null ? asOf : today;
         return rows.stream().map(r -> PendingRequestResponse.from(r, aging, day)).toList();
     }
 }
