+                .andExpect(jsonPath("$[1].id").value("PA-10244"))
+                .andExpect(jsonPath("$[1].ageBusinessDays").value(59))
+                .andExpect(jsonPath("$[2].id").value("PA-10263"))
+                .andExpect(jsonPath("$[2].ageBusinessDays").value(56));
+    }
